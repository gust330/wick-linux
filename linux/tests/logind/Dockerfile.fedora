ARG BASE=fedora:42
FROM ${BASE}
RUN dnf -y -q install systemd systemd-udev polkit dbus-daemon python3 python3-pip procps-ng perl-interpreter util-linux shadow-utils which findutils >/dev/null
# udevd in a privileged container would act on the devices of the machine it runs on.
RUN useradd -m dev; systemctl mask getty@tty1.service console-getty.service systemd-firstboot.service systemd-homed.service systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket systemd-udev-trigger.service systemd-udev-settle.service systemd-networkd.service systemd-resolved.service >/dev/null 2>&1; ln -sf /usr/lib/systemd/systemd /sbin/init 2>/dev/null; true
CMD ["/sbin/init"]
